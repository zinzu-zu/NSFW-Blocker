# ============================================================================
#  my-phone.conf: what phone-kit puts on every phone you set up
# ============================================================================
#
#  How to edit this file
#  - Each setting is one NAME=value. A # starts a note, which the kit ignores.
#  - Lists hold app package names (or web addresses for NEWS_SITES). Write
#    them on one line, separated by commas, or one per line, indented:
#
#        BLOCK_APPS=
#            com.google.android.apps.photos     # Google Photos
#            com.facebook.katana                # Facebook
#
#  - An app's package name is the end of its Play Store link:
#    play.google.com/store/apps/details?id=com.whatsapp  ->  com.whatsapp
#  - Left empty, a setting uses the default its note describes.
#  - After a change, plug the phone in and run "Set up a phone.command" again.
#    It changes only what's different.
#
#  Only section 1 has to be filled in. The rest can stay as it is.


# ----------------------------------------------------------------------------
#  1. NextDNS (required)
# ----------------------------------------------------------------------------

# Your NextDNS address for Android: my.nextdns.io › Setup › Android.
# The kit sets the phone's Private DNS to it and locks it.
NEXTDNS_HOST=abc123.dns.nextdns.io


# ----------------------------------------------------------------------------
#  2. Which apps can run
# ----------------------------------------------------------------------------

# no  = blocklist mode: every app runs, except other browsers, the Instagram
#       and Reddit apps, and the apps in BLOCK_APPS.
# yes = allowlist mode: only the apps in APP_LIST run, plus Firefox and the
#       phone's basics (calls, messages, contacts, clock, keyboard, Settings).
ONLY_LISTED_APPS=no

# Blocklist: apps that are always paused.
BLOCK_APPS=

# Allowlist: apps that are never paused. It only matters with
# ONLY_LISTED_APPS=yes. Firefox needn't be listed. Other browsers and the
# Instagram or Reddit apps can't be on it.
APP_LIST=

# Apps hidden from the phone altogether. Apps that aren't installed are skipped.
HIDE_APPS=
    com.android.chrome          # Chrome
    org.mozilla.focus           # Firefox Focus
    io.nextdns.NextDNS          # NextDNS

# Apps that can't be uninstalled, stopped or cleared. Feed Guard, Watch Limit
# and Firefox always are; list any others here.
PROTECT_APPS=

# yes = the default browser, home screen and phone app can't be changed
# (Android 14 and newer). Empty = the same as ONLY_LISTED_APPS.
LOCK_DEFAULT_APPS=


# ----------------------------------------------------------------------------
#  3. Black and white screen
# ----------------------------------------------------------------------------

# yes = the screen stays black and white.
BLACK_AND_WHITE=yes

# Apps that still show colour. Empty = the maps apps (Google Maps, CoMaps,
# Organic Maps). none = no colour anywhere.
COLOR_APPS=


# ----------------------------------------------------------------------------
#  4. Banking mode
# ----------------------------------------------------------------------------

# Bank apps that refuse to open while the lock is on. Opening one switches
# Feed Guard and Watch Limit off for 10 minutes.
# Empty = Nubank. none = banking mode off.
BANK_APPS=


# ----------------------------------------------------------------------------
#  5. Morning news block
# ----------------------------------------------------------------------------

# After you wake up, these sites are blocked in Firefox for a while.
# Each one covers its subdomains too (globo.com covers g1.globo.com).
# Empty = Feed Guard's own list of Brazilian and international news.
# A list here replaces it. none = no sites.
NEWS_SITES=

# News apps paused at the same time, besides apps that call themselves news
# apps. Empty = Feed Guard's own list (Google News, g1, CNN, BBC News and
# others, plus YouTube ReVanced). none = only the self-declared news apps.
NEWS_APPS=


# ----------------------------------------------------------------------------
#  6. The NSFW Blocker add-on for Firefox
# ----------------------------------------------------------------------------

# Where the signed add-on (.xpi) is kept on this Mac: a file, or a folder.
# The kit puts the newest signed version on the phone, and again whenever a
# newer one turns up. File names don't matter. Empty = only .xpi files in apks.
# For example: ADDON_FILE=~/Claude Projects/Scripts/Finished/NSFW-blocker
ADDON_FILE=

# Only used when there's no .xpi: the add-on's page on addons.mozilla.org,
# for the kit to open in Firefox. Empty = you look it up there yourself.
ADDON_PAGE=


# ----------------------------------------------------------------------------
#  7. How the kit works (leave as it is)
# ----------------------------------------------------------------------------

# yes = the kit switches OwnDroid's restrictions on itself, through OwnDroid's
#       API, which it turns off again before it finishes.
# no  = you switch them on in OwnDroid, from the list the kit shows.
USE_OWNDROID_API=yes
