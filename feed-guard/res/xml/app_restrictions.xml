<?xml version="1.0" encoding="utf-8"?>
<!-- Feed Guard's settings, edited in OwnDroid (Applications > Feed Guard >
     Managed configuration). OwnDroid stores only the keys someone set; Feed
     Guard uses the default for the rest. -->
<restrictions xmlns:android="http://schemas.android.com/apk/res/android">
    <restriction
        android:key="allowed_apps"
        android:title="@string/r_allowed_title"
        android:description="@string/r_allowed_desc"
        android:restrictionType="string"
        android:defaultValue="" />
    <restriction
        android:key="only_listed_apps"
        android:title="@string/r_list_title"
        android:description="@string/r_list_desc"
        android:restrictionType="bool"
        android:defaultValue="false" />
    <restriction
        android:key="grayscale"
        android:title="@string/r_gray_title"
        android:description="@string/r_gray_desc"
        android:restrictionType="bool"
        android:defaultValue="true" />
    <restriction
        android:key="color_apps"
        android:title="@string/r_color_title"
        android:description="@string/r_color_desc"
        android:restrictionType="string"
        android:defaultValue="com.google.android.apps.maps, app.comaps.google, app.comaps.fdroid, app.organicmaps" />
    <restriction
        android:key="blocked_apps"
        android:title="@string/r_blocked_title"
        android:description="@string/r_blocked_desc"
        android:restrictionType="string"
        android:defaultValue="" />
    <restriction
        android:key="bank_apps"
        android:title="@string/r_bank_title"
        android:description="@string/r_bank_desc"
        android:restrictionType="string"
        android:defaultValue="com.nu.production" />
    <restriction
        android:key="news_block"
        android:title="@string/r_news_title"
        android:description="@string/r_news_desc"
        android:restrictionType="bool"
        android:defaultValue="true" />
    <restriction
        android:key="news_gap_hours"
        android:title="@string/r_news_gap_title"
        android:description="@string/r_news_gap_desc"
        android:restrictionType="integer"
        android:defaultValue="6" />
    <restriction
        android:key="news_from_hour"
        android:title="@string/r_news_from_title"
        android:description="@string/r_news_from_desc"
        android:restrictionType="integer"
        android:defaultValue="6" />
    <restriction
        android:key="news_until_hour"
        android:title="@string/r_news_until_title"
        android:description="@string/r_news_until_desc"
        android:restrictionType="integer"
        android:defaultValue="12" />
    <restriction
        android:key="news_minutes"
        android:title="@string/r_news_minutes_title"
        android:description="@string/r_news_minutes_desc"
        android:restrictionType="integer"
        android:defaultValue="150" />
    <restriction
        android:key="news_sites"
        android:title="@string/r_news_sites_title"
        android:description="@string/r_news_sites_desc"
        android:restrictionType="string"
        android:defaultValue="globo.com, uol.com.br, folha.com.br, estadao.com.br, cnnbrasil.com.br, r7.com, terra.com.br, metropoles.com, poder360.com.br, veja.abril.com.br, exame.com, cartacapital.com.br, gazetadopovo.com.br, infomoney.com.br, band.com.br, sbtnews.sbt.com.br, jovempan.com.br, correiobraziliense.com.br, istoe.com.br, bbc.com, bbc.co.uk, g1.com.br, news.google.com, cnn.com, nytimes.com, theguardian.com, reuters.com, apnews.com, washingtonpost.com, aljazeera.com, bloomberg.com, foxnews.com, nbcnews.com, economist.com, elpais.com, lemonde.fr, news.yahoo.com, msn.com" />
    <restriction
        android:key="news_apps"
        android:title="@string/r_news_apps_title"
        android:description="@string/r_news_apps_desc"
        android:restrictionType="string"
        android:defaultValue="com.google.android.apps.magazines, com.globo.g1.app, com.cnn.mobile.android.phone, mnn.Android, bbc.mobile.news.ww, bbc.mobile.news.uk, com.nytimes.android, com.guardian, com.washingtonpost.rainbow, com.foxnews.android, com.zumobi.msnbc, com.bloomberg.android.plus, com.microsoft.amp.apps.bingnews, app.revanced.android.youtube, app.rvx.android.youtube, com.vanced.android.youtube" />
</restrictions>
